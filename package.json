{
  "name": "frp-bridge-monorepo",
  "type": "module",
  "version": "0.0.5",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "description": "Frp bridge",
  "author": "imba97",
  "license": "MIT",
  "homepage": "https://github.com/frp-web/bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+git@github.com:frp-web/bridge.git"
  },
  "bugs": {
    "url": "https://github.com/frp-web/bridge/issues"
  },
  "keywords": [
    "frp"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "pnpm -r run dev",
    "build": "pnpm -r run build",
    "test": "vitest --run",
    "lint": "eslint --cache",
    "release": "bumpp -r",
    "frpx": "node ./packages/cli/bin/index.mjs",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "defu": "^6.1.4",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "bumpp": "^11.0.1",
    "eslint": "^10.0.3",
    "lint-staged": "^16.4.0",
    "rolldown": "1.0.0-rc.10",
    "rolldown-plugin-dts": "^0.22.5",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --cache --fix"
  }
}
