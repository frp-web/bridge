{
  "name": "frp-bridge",
  "type": "module",
  "version": "0.0.5",
  "description": "Frp bridge main package",
  "license": "MIT",
  "homepage": "https://github.com/frp-web/bridge#readme",
  "repository": {
    "type": "git",
    "url": "git@github.com:frp-web/bridge.git"
  },
  "bugs": {
    "url": "https://github.com/frp-web/bridge/issues"
  },
  "keywords": [
    "frp",
    "bridge",
    "main"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./process": {
      "types": "./dist/process.d.ts",
      "import": "./dist/process.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "rolldown -c --watch",
    "build": "rolldown -c"
  },
  "dependencies": {
    "@frp-bridge/core": "workspace:*",
    "@frp-bridge/shared": "workspace:*",
    "@frp-bridge/types": "workspace:*"
  }
}
